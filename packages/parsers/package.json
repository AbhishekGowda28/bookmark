{
  "name": "@bookmark/parsers",
  "version": "1.0.0",
  "description": "Parsers for XBEL, Markdown, and RSS formats",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/index.test.ts",
    "lint": "eslint src --max-warnings 0",
    "format": "prettier --write src"
  },
  "dependencies": {
    "@bookmark/types": "workspace:*",
    "@bookmark/utils": "workspace:*",
    "markdown-it": "^13.0.1",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/markdown-it": "^13.0.5",
    "@types/node": "^20.0.0",
    "@types/xml2js": "^0.4.14",
    "tsx": "^4.21.0"
  },
  "keywords": [
    "parsers",
    "xbel",
    "markdown",
    "rss"
  ],
  "author": "Abhishek Gowda",
  "license": "MIT"
}
