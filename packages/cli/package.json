{
  "name": "@bookmark/cli",
  "version": "1.0.0",
  "description": "CLI orchestrator for link aggregation and data pipeline",
  "type": "module",
  "bin": {
    "bookmark-cli": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc --noEmit",
    "start": "node dist/cli.js",
    "fetch": "node dist/cli.js fetch",
    "aggregate": "node dist/cli.js aggregate",
    "test": "tsx --test src/index.test.ts",
    "lint": "eslint src --max-warnings 0",
    "format": "prettier --write src"
  },
  "dependencies": {
    "@bookmark/core": "workspace:*",
    "@bookmark/parsers": "workspace:*",
    "@bookmark/pipeline": "workspace:*",
    "@bookmark/schema": "workspace:*",
    "@bookmark/types": "workspace:*",
    "@bookmark/utils": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.21.0"
  },
  "keywords": ["cli", "orchestrator", "links"],
  "author": "Abhishek Gowda",
  "license": "MIT"
}
