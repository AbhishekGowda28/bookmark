{
  "name": "@bookmark/hooks",
  "version": "1.0.0",
  "description": "React hooks for bookmark application",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "format": "prettier --write src"
  },
  "dependencies": {
    "@bookmark/types": "workspace:*",
    "fuse.js": "^7.0.0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0"
  },
  "peerDependencies": {
    "react": "^18.0.0"
  },
  "keywords": ["hooks", "react", "search"],
  "author": "Abhishek Gowda",
  "license": "MIT"
}
