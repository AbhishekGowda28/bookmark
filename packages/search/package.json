{
  "name": "@bookmark/search",
  "version": "1.0.0",
  "description": "Pure search functions using Fuse.js - zero dependencies on React",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./config": {
      "import": "./dist/config.js",
      "types": "./dist/config.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/index.test.ts",
    "lint": "eslint src --max-warnings 0",
    "format": "prettier --write src"
  },
  "dependencies": {
    "@bookmark/types": "workspace:*",
    "fuse.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.21.0"
  },
  "keywords": ["search", "fuse", "fuzzy"],
  "author": "Abhishek Gowda",
  "license": "MIT"
}
