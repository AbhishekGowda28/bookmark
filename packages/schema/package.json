{
  "name": "@bookmark/schema",
  "version": "1.0.0",
  "description": "Centralized Zod-based data validation schemas for all data contracts",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/index.test.ts",
    "lint": "eslint src --max-warnings 0",
    "format": "prettier --write src"
  },
  "dependencies": {
    "@bookmark/types": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.21.0"
  },
  "keywords": ["schema", "validation", "zod"],
  "author": "Abhishek Gowda",
  "license": "MIT"
}
