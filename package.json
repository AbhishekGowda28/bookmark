{
  "name": "bookmark",
  "version": "1.0.0",
  "description": "Searchable bookmark and RSS feed aggregator",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@8.10.0",
  "scripts": {
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "cli": "node packages/cli/dist/cli.js",
    "web:dev": "pnpm --filter @bookmark/web dev",
    "web:build": "pnpm --filter @bookmark/web build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "eslint": "^10.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript": "^5.2.0"
  },
  "keywords": [
    "bookmarks",
    "rss",
    "aggregator"
  ],
  "author": "Abhishek Gowda",
  "license": "MIT",
  "dependencies": {
    "tsx": "^4.21.0"
  }
}
